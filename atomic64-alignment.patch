 	/* 64bit atomic operations */
 
+	// A guest pointer only has to be 4-byte aligned for these: the console's PowerPC has no
+	// 64-bit atomic instruction, so coreinit implements them with a lock and alignment never
+	// mattered. std::atomic<uint64> is fine with that on x86, but on AArch64 it compiles to
+	// exclusive load/store instructions that FAULT on a misaligned address (SIGBUS, seen on
+	// device in Angry Birds Star Wars, which passes a 4-byte-aligned counter to OSSetAtomic64).
+	// Serialise the misaligned case behind a lock and do a plain read-modify-write instead.
+	static std::mutex s_unalignedAtomic64Mutex;
+
+	inline bool IsAtomic64Aligned(const void* mem)
+	{
+		return (reinterpret_cast<uintptr_t>(mem) & 7) == 0;
+	}
+
+	inline uint64be LoadUnaligned64(const std::atomic<uint64be>* mem)
+	{
+		uint64be value;
+		std::memcpy(&value, mem, sizeof(value));
+		return value;
+	}
+
+	inline void StoreUnaligned64(std::atomic<uint64be>* mem, uint64be value)
+	{
+		std::memcpy(mem, &value, sizeof(value));
+	}
+
 	uint64 OSSwapAtomic64(std::atomic<uint64be>* mem, uint64 newValue)
 	{
+		if (!IsAtomic64Aligned(mem))
+		{
+			std::lock_guard lock(s_unalignedAtomic64Mutex);
+			const uint64be previous = LoadUnaligned64(mem);
+			StoreUnaligned64(mem, newValue);
+			return previous;
+		}
 		uint64be _newValue = newValue;
 		uint64be previousValue = mem->exchange(_newValue);
 		return previousValue;
