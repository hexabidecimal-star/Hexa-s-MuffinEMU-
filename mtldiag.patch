+                core, samples[0], samples[1], samples[2], samples[3], samples[4], samples[5], samples[6], samples[7],
+                g_diagGuestEnters[core].load(std::memory_order_relaxed));
+
+            const uint32 pc = samples[7];
+            if (pc < 0x02000000 || pc >= 0x50000000)
+                continue;
+            uint8* codePtr = memory_getPointerFromVirtualOffsetAllowNull(pc - 32);
+            if (!codePtr)
+                continue;
+            std::string dump;
+            for (uint32 i = 0; i < 16; i++)
+            {
+                uint32 word = _swapEndianU32(*(uint32*)(codePtr + i * 4));
+                dump += fmt::format("{:08x} ", word);
+            }
+            cemuLog_log(LogType::Force, "MTLWATCH   core{} code at {:08x}-{:08x}: {}", core, pc - 32, pc + 28, dump);
+
+            // Any call in that window that lands on an emulated system function: name it.
+            for (uint32 i = 0; i < 16; i++)
+            {
+                const uint32 addr = pc - 32 + i * 4;
+                const uint32 word = _swapEndianU32(*(uint32*)(codePtr + i * 4));
+                if ((word >> 26) != 18 || (word & 1) == 0) // bl only
+                    continue;
+                sint32 offset = (sint32)(word & 0x03FFFFFC);
+                if (offset & 0x02000000)
+                    offset -= 0x04000000;
+                const uint32 target = (word & 2) ? (uint32)offset : (uint32)(addr + offset);
+                uint8* targetPtr = memory_getPointerFromVirtualOffsetAllowNull(target);
+                if (!targetPtr)
+                    continue;
+                const uint32 targetWord = _swapEndianU32(*(uint32*)targetPtr);
+                if ((targetWord >> 26) != 1) // not an HLE trampoline
+                    continue;
+                const char* name = osLib_getFunctionNameByHLEIndex((sint32)(targetWord & 0xFFFF));
+                cemuLog_log(LogType::Force, "MTLWATCH   core{} call at {:08x} -> {:08x} = {}", core, addr, target,
+                    name ? name : "<unnamed HLE call>");
+            }
+        }
+    }
