+    // What the game's own threads are doing while the GPU side has nothing to do.
+    void MtlDumpGuestThreads(uint32 snapshot)
+    {
+        srwlock_activeThreadList.LockRead();
+        const sint32 count = activeThreadCount;
+        cemuLog_log(LogType::Force, "MTLWATCH guest thread snapshot {} ({} threads)", snapshot, count);
+        for (sint32 i = 0; i < count && i < 64; i++)
+        {
+            MPTR threadMPTR = activeThread[i];
+            if (!threadMPTR)
+                continue;
+            OSThread_t* thread = (OSThread_t*)memory_getPointerFromVirtualOffset(threadMPTR);
+            if (!thread)
+                continue;
+            const char* name = thread->threadName.GetPtr() ? thread->threadName.GetPtr() : "<unnamed>";
+            cemuLog_log(LogType::Force,
