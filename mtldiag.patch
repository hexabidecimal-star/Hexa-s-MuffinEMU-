+        const uintptr_t threadHandle = g_mtlStageThread.load(std::memory_order_relaxed);
+        if (!threadHandle)
+            return;
+        g_mtlStallFrameCount.store(-1, std::memory_order_release);
+        if (pthread_kill((pthread_t)threadHandle, SIGUSR1) != 0)
+        {
+            cemuLog_log(LogType::Force, "MTLWATCH could not signal the stalled thread");
+            return;
+        }
+        for (int i = 0; i < 100 && g_mtlStallFrameCount.load(std::memory_order_acquire) < 0; i++)
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        const int count = g_mtlStallFrameCount.load(std::memory_order_acquire);
+        if (count <= 0)
+        {
+            cemuLog_log(LogType::Force, "MTLWATCH stalled thread did not answer the signal");
+            return;
+        }
+        char** symbols = backtrace_symbols(g_mtlStallFrames, count);
+        cemuLog_log(LogType::Force, "MTLWATCH backtrace of the stalled thread ({} frames):", count);
+        for (int i = 0; i < count; i++)
+            cemuLog_log(LogType::Force, "MTLWATCH   {}", symbols ? symbols[i] : "<no symbol>");
+        if (symbols)
+            free(symbols);
+    }
+
+    void MtlStartWatchdog()
+    {
+        bool expected = false;
+        if (!g_mtlWatchdogStarted.compare_exchange_strong(expected, true))
+            return;
+        struct sigaction sa{};
+        sa.sa_handler = MtlStallSignalHandler;
+        sa.sa_flags = SA_RESTART;
+        sigemptyset(&sa.sa_mask);
+        sigaction(SIGUSR1, &sa, nullptr);
+
+        std::thread([]() {
+            uint64 lastSwaps = 0, lastTicks = 0, lastPackets = 0;
+            uint32 stalledSeconds = 0;
+            uint32 dumpsTaken = 0;
+            while (true)
+            {
+                std::this_thread::sleep_for(std::chrono::seconds(2));
+                const uint64 swaps = g_mtlTotalSwaps.load(std::memory_order_relaxed);
+                const uint64 ticks = g_mtlStageTicks.load(std::memory_order_relaxed);
+                const uint64 packets = g_diagCPPackets.load(std::memory_order_relaxed);
+                if (swaps != lastSwaps)
+                {
+                    lastSwaps = swaps; lastTicks = ticks; lastPackets = packets;
+                    stalledSeconds = 0;
+                    dumpsTaken = 0;
+                    continue;
+                }
+                stalledSeconds += 2;
+                cemuLog_log(LogType::Force,
+                    "MTLWATCH stalled {}s | stage={} stageTicks={} (+{}) cpPackets={} (+{}) swaps={} drawCalls={} | drawDone enter={} exit={} | flipWait enter={} exit={} | scanCopy={} scanNoView={}",
+                    stalledSeconds,
+                    g_mtlStage.load(std::memory_order_relaxed), ticks, ticks - lastTicks,
+                    packets, packets - lastPackets, swaps,
+                    (uint32)LatteGPUState.drawCallCounter,
+                    GX2::g_diagDrawDoneEnter.load(std::memory_order_relaxed), GX2::g_diagDrawDoneExit.load(std::memory_order_relaxed),
+                    GX2::g_diagFlipWaitEnter.load(std::memory_order_relaxed), GX2::g_diagFlipWaitExit.load(std::memory_order_relaxed),
+                    g_diagScanCopyCalls, g_diagScanCopyNoView);
+                // Two snapshots: one as soon as it is clearly stuck, one later to show
+                // whether it is parked in one place or looping.
+                if ((stalledSeconds == 4 && dumpsTaken == 0) || (stalledSeconds == 20 && dumpsTaken == 1))
+                {
+                    dumpsTaken++;
+                    MtlDumpStalledThread();
+                }
+                lastTicks = ticks;
+                lastPackets = packets;
+            }
+        }).detach();
+    }
+}
