+    void MtlStartWatchdog()
+    {
+        bool expected = false;
+        if (!g_mtlWatchdogStarted.compare_exchange_strong(expected, true))
+            return;
+        std::thread([]() {
+            uint64 lastSwaps = 0, lastTicks = 0, lastPackets = 0, lastIdleSpins = 0;
+            uint32 stalledSeconds = 0;
+            uint32 dumpsTaken = 0;
+            while (true)
+            {
+                std::this_thread::sleep_for(std::chrono::seconds(2));
+                const uint64 swaps = g_mtlTotalSwaps.load(std::memory_order_relaxed);
+                const uint64 ticks = g_mtlStageTicks.load(std::memory_order_relaxed);
+                const uint64 packets = g_diagCPPackets.load(std::memory_order_relaxed);
+                const uint64 idleSpins = g_diagCPIdleSpins.load(std::memory_order_relaxed);
+                if (swaps != lastSwaps)
+                {
+                    lastSwaps = swaps; lastTicks = ticks; lastPackets = packets; lastIdleSpins = idleSpins;
+                    stalledSeconds = 0;
+                    dumpsTaken = 0;
+                    continue;
+                }
+                stalledSeconds += 2;
+                cemuLog_log(LogType::Force,
+                    "MTLWATCH stalled {}s | stage={} stageTicks={} (+{}) cpPackets={} (+{}) cpIdleSpins=+{} swaps={} drawCalls={} | guestPC {:08x}/{:08x}/{:08x} enters={}/{}/{} | drawDone enter={} exit={} | flipWait enter={} exit={} | scanCopy={} scanNoView={}",
+                    stalledSeconds,
+                    g_mtlStage.load(std::memory_order_relaxed), ticks, ticks - lastTicks,
+                    packets, packets - lastPackets,
+                    g_diagCPIdleSpins.load(std::memory_order_relaxed) - lastIdleSpins, swaps,
+                    (uint32)LatteGPUState.drawCallCounter,
+                    g_diagGuestPC[0].load(std::memory_order_relaxed), g_diagGuestPC[1].load(std::memory_order_relaxed), g_diagGuestPC[2].load(std::memory_order_relaxed),
+                    g_diagGuestEnters[0].load(std::memory_order_relaxed), g_diagGuestEnters[1].load(std::memory_order_relaxed), g_diagGuestEnters[2].load(std::memory_order_relaxed),
+                    GX2::g_diagDrawDoneEnter.load(std::memory_order_relaxed), GX2::g_diagDrawDoneExit.load(std::memory_order_relaxed),
+                    GX2::g_diagFlipWaitEnter.load(std::memory_order_relaxed), GX2::g_diagFlipWaitExit.load(std::memory_order_relaxed),
+                    g_diagScanCopyCalls, g_diagScanCopyNoView);
+                // Two snapshots of the emulated console's own threads: one as soon as it
+                // is clearly stuck, one later, so a thread that is moving can be told from
+                // one that is parked.
+                if ((stalledSeconds == 4 && dumpsTaken == 0) || (stalledSeconds == 20 && dumpsTaken == 1))
+                {
+                    dumpsTaken++;
+                    MtlDumpGuestThreads(dumpsTaken);
+                }
+                lastTicks = ticks;
+                lastPackets = packets;
+                lastIdleSpins = idleSpins;
+            }
+        }).detach();
+    }
